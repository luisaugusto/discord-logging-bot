{
  "name": "discord-logging-bot",
  "version": "2.8.3",
  "description": "A bot used to log information about a Discord server",
  "main": "index.js",
  "author": "Luis Augusto",
  "license": "MIT",
  "scripts": {
    "start:local": "yarn deploy-commands:local && node --env-file=.env .",
    "start": "yarn deploy-commands && node .",
    "watch": "tsc --watch",
    "deploy-commands:local": "node --env-file=.env deploy-commands.js",
    "deploy-commands": "node deploy-commands.js",
    "build": "tsc",
    "lint": "eslint .",
    "lintfix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,json}\"",
    "format:lint": "prettier --check \"**/*.{ts,json}\""
  },
  "dependencies": {
    "@discordjs/rest": "^2.0.0",
    "@logtail/node": "^0.5.2",
    "axios": "^1.3.5",
    "date-fns": "^4.1.0",
    "discord-api-types": "^0.37.37",
    "discord.js": "^14.0.3",
    "firebase": "^11.0.1",
    "openai": "^4.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "globals": "^15.14.0",
    "prettier": "^3.0.1",
    "typescript": "^5.0.4",
    "typescript-eslint": "^8.18.1"
  },
  "engines": {
    "node": "^20.6.0"
  }
}
